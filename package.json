{
  "name": "steam-master-idler",
  "productName": "Steam Master Idler",
  "version": "1.5.0",
  "description": "Desktop app to idle Steam games until a playtime target is reached, and farm trading-card drops.",
  "main": "src/main.js",
  "author": "MEZTKING",
  "homepage": "https://github.com/MEZTKING/Steam-Master-Idler",
  "repository": "github:MEZTKING/Steam-Master-Idler",
  "scripts": {
    "start": "electron .",
    "web": "node src/server.js",
    "cli": "node src/cli.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.meztking.steammasteridler",
    "productName": "Steam Master Idler",
    "files": [
      "src/**/*",
      "public/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/koffi/{src,vendor,doc}/**",
      "!node_modules/koffi/build/koffi/{freebsd_*,openbsd_*,musl_*,linux_ia32,linux_armhf,linux_loong64,linux_riscv64d}/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Steam-Master-Idler-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Steam-Master-Idler-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "assets/icon.png",
      "artifactName": "Steam-Master-Idler-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "assets/icon.png",
      "artifactName": "Steam-Master-Idler-${version}-${arch}.${ext}",
      "maintainer": "MEZTKING <MEZTKING@users.noreply.github.com>"
    },
    "asarUnpack": [
      "node_modules/koffi/**",
      "src/steamapp/**"
    ]
  },
  "dependencies": {
    "koffi": "^2.16.3",
    "qrcode": "^1.5.4",
    "steam-session": "^1.9.4",
    "steam-user": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
